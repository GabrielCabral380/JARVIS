# JARVIS Local Hub
PORT=3000
JARVIS_NAME=JARVIS
JARVIS_PERSONALITY=calm, precise, cinematic, helpful
AUTO_OPEN_BROWSER=true

# AI provider:
# local      = no cloud API, rule-based fallback
# openai     = OpenAI SDK with OPENAI_API_KEY
# openrouter = OpenRouter via OpenAI-compatible SDK
AI_PROVIDER=local

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_SITE_NAME=JARVIS Local Hub

# Optional Codex CLI bridge
# Install manually with: npm install -g @openai/codex
# First run "codex" in PowerShell and sign in.
CODEX_ENABLED=false
CODEX_WORKDIR=
CODEX_TIMEOUT_MS=120000

# Notes
OBSIDIAN_VAULT_PATH=
# Orquestrador local
HERMES_ENABLED=true
HERMES_URL=
HERMES_COMMAND=
OPENCLAW_ENABLED=true
OPENCLAW_URL=
OPENCLAW_COMMAND=
MCP_ENABLED=true
MCP_URL=
MCP_COMMAND=

# Ferramentas locais offline
LOCAL_TOOLS_ENABLED=true
LOCAL_TOOLS_REQUIRE_CONFIRMATION=false
