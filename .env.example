# JARVIS Local Hub
PORT=3000
JARVIS_NAME=JARVIS
JARVIS_PERSONALITY=calm, precise, cinematic, helpful
AUTO_OPEN_BROWSER=false

# AI provider:
# local      = no cloud API, rule-based fallback
# gemini     = Google Gemini (GEMINI_API_KEY)
# openai     = OpenAI SDK with OPENAI_API_KEY
# openrouter = OpenRouter via OpenAI-compatible SDK
AI_PROVIDER=local

# Gemini (Google)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_SITE_URL=https://gabrielcabral380.github.io/JARVIS/
OPENROUTER_SITE_NAME=JARVIS Cloud Access

# Optional Codex CLI bridge
# Install manually with: npm install -g @openai/codex
# First run "codex" in PowerShell and sign in.
CODEX_ENABLED=false
CODEX_WORKDIR=
CODEX_TIMEOUT_MS=120000

# Notes
OBSIDIAN_VAULT_PATH=
# Orquestrador local
HERMES_ENABLED=true
HERMES_URL=
HERMES_COMMAND=
OPENCLAW_ENABLED=true
OPENCLAW_URL=
OPENCLAW_COMMAND=
MCP_ENABLED=true
MCP_URL=
MCP_COMMAND=

# Ferramentas locais offline
LOCAL_TOOLS_ENABLED=true
LOCAL_TOOLS_REQUIRE_CONFIRMATION=false

# Aprovação de ações sensíveis: once | always | off
APPROVAL_POLICY=once
